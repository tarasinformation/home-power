# Монітор світла на тій самій платі: Bluetooth лише для прослуховування оголошень станції EcoFlow.
# Підключати ЗАМІСТЬ ../firmware/sdkconfig.defaults.nobt, останнім:
#   ../firmware/sdkconfig.defaults; ../firmware/sdkconfig.defaults.esp32c6; sdkconfig.defaults.reader; sdkconfig.defaults.power
# Збирати в новій папці збірки.

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Matter Bluetooth не використовує: хаб додається по мережі
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
# Лише роль спостерігача: без з'єднань, без оголошень, без захисту з'єднань
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Контролер Bluetooth спить між скануваннями, щоб не заважати легкому сну процесора
CONFIG_BT_LE_SLEEP_ENABLE=y
# Потрібно для сну Bluetooth на ESP32-C6: радіочастина вимикається, коли нею ніхто не користується
CONFIG_ESP_PHY_MAC_BB_PD=y
