# Консоль (журнал і команди) через вбудований USB плати: окремого UART-перехідника на ній немає.
# УВАГА: після зміни цього налаштування збирати в НОВІЙ папці збірки (-B ...). Бібліотека CHIP
# збирається окремо (GN) і при зміні sdkconfig у тій самій папці не перезбирається: консоль тоді
# лишається налаштованою на старий порт, а її задача крутиться без пауз (так було 25.11.2026).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
