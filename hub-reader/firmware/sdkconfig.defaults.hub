# Для сполучення зі справжнім хабом Aqara: довіряти лише кореневим сертифікатам із розділу paa_cert
# (образ збирається з папки paa_cert_hub), а не вшитим тестовим. Перевірка атестації лишається ввімкненою.
# Збирати в новій папці збірки (див. sdkconfig.defaults.usbconsole).
CONFIG_SPIFFS_ATTESTATION_TRUST_STORE=y
